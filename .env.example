# Copie para .env. Nada aqui é segredo real: são valores locais de demonstração.

# Postgres
POSTGRES_PASSWORD=postgres
CRM_API_DB_PASSWORD=crm_api_local

# API
# AUTH_DEV=1 aceita o token "dev:<email>" (só para rodar local, nunca em produção).
AUTH_DEV=1
# Login do painel por Google: ID do cliente OAuth. Vazio = só AUTH_DEV ou chaves de API.
GOOGLE_CLIENT_ID=
CORS_ORIGENS=http://localhost:5173
PAINEL_URL=http://localhost:5173

# Classificação de respostas (opcional). Qualquer API de chat completions serve.
# Sem isso toda resposta é classificada como "generico".
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# n8n
N8N_ENCRYPTION_KEY=troque-esta-chave-local
# JSON por caixa: {"ana@example.com": {"host":"smtp.example.com","port":587,"secure":false,"user":"...","pass":"..."}}
CRM_SMTP={}
CRM_CAIXA_ATUAL=ana@example.com
CRM_AVISOS_REMETENTE=avisos@example.com
CRM_AVISOS_ADMIN=ana@example.com

# Painel (web/.env.local)
# VITE_API_URL=http://localhost:8000
# VITE_DEV_LOGIN=1
# VITE_GOOGLE_CLIENT_ID=
